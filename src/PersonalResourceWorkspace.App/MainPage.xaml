<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="PersonalResourceWorkspace.App.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:PersonalResourceWorkspace.App"
    AllowDrop="True"
    Background="Transparent"
    DragEnter="WorkArea_DragOver"
    DragLeave="WorkArea_DragLeave"
    DragOver="WorkArea_DragOver"
    Drop="WorkArea_Drop"
    SizeChanged="MainPage_SizeChanged">

    <NavigationView
        x:Name="ShellNavigation"
        AlwaysShowHeader="False"
        CompactModeThresholdWidth="720"
        CompactPaneLength="48"
        ExpandedModeThresholdWidth="1100"
        IsBackButtonVisible="Collapsed"
        IsPaneOpen="True"
        IsPaneToggleButtonVisible="True"
        IsSettingsVisible="True"
        ItemInvoked="ShellNavigation_ItemInvoked"
        OpenPaneLength="264"
        PaneDisplayMode="Auto">

        <NavigationView.PaneHeader>
            <StackPanel Margin="4,0,0,14" Orientation="Horizontal" Spacing="10">
                <Border Width="32" Height="32" Background="{ThemeResource AccentFillColorDefaultBrush}" CornerRadius="9">
                    <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="17" FontWeight="SemiBold" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" Text="P" />
                </Border>
                <TextBlock VerticalAlignment="Center" FontSize="16" FontWeight="SemiBold" Text="Personal Space" />
            </StackPanel>
        </NavigationView.PaneHeader>

        <NavigationView.MenuItems>
            <NavigationViewItem x:Name="AllResourcesNavItem" IsSelected="True" Tag="all">
                <NavigationViewItem.Icon><SymbolIcon Symbol="Home" /></NavigationViewItem.Icon>
                <NavigationViewItem.Content>
                    <Grid MinWidth="174" ColumnSpacing="8">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBlock Text="Все ресурсы" />
                        <TextBlock x:Name="AllResourcesCount" Grid.Column="1" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                    </Grid>
                </NavigationViewItem.Content>
            </NavigationViewItem>
            <NavigationViewItemHeader Content="Сохранённые поиски" />
        </NavigationView.MenuItems>

        <Grid
            x:Name="WorkArea"
            AllowDrop="True"
            Background="Transparent"
            DragEnter="WorkArea_DragOver"
            DragLeave="WorkArea_DragLeave"
            DragOver="WorkArea_DragOver"
            Drop="WorkArea_Drop"
            Padding="28,20,28,22">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>

            <Grid x:Name="HeaderGrid" Margin="0,0,0,14" ColumnSpacing="12" RowSpacing="10">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>

                <StackPanel x:Name="TitleBlock" Orientation="Horizontal" Spacing="10">
                    <TextBlock x:Name="PageTitle" VerticalAlignment="Center" FontSize="28" FontWeight="SemiBold" Text="Все ресурсы" />
                    <TextBlock x:Name="PageCountText" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="0" />
                </StackPanel>

                <AutoSuggestBox
                    x:Name="SearchBox"
                    Grid.Row="1"
                    Grid.ColumnSpan="3"
                    MaxWidth="320"
                    HorizontalAlignment="Stretch"
                    AutomationProperties.Name="Поиск ресурсов"
                    PlaceholderText="Найти ресурс..."
                    QueryIcon="Find"
                    TextChanged="SearchBox_TextChanged" />

                <StackPanel Grid.Row="2" Grid.ColumnSpan="3" Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="Условия:" VerticalAlignment="Center" />
                    <StackPanel x:Name="BaseTagsPanel" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center" />
                    <StackPanel x:Name="TemporaryTagsPanel" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center" />
                    <AutoSuggestBox x:Name="TagFilterBox" Width="170" PlaceholderText="Добавить тэг" QuerySubmitted="TagFilter_QuerySubmitted" TextChanged="TagFilter_TextChanged" />
                    <Button Content="Сохранить поиск" Click="SaveSearch_Click" />
                </StackPanel>

                <CommandBar
                    x:Name="WorkspaceCommandBar"
                    Grid.Row="3"
                    Grid.ColumnSpan="3"
                    HorizontalAlignment="Stretch"
                    Background="Transparent"
                    ClosedDisplayMode="Compact"
                    DefaultLabelPosition="Right"
                    IsDynamicOverflowEnabled="True">
                    <AppBarButton x:Name="AddResourceButton" AutomationProperties.Name="Добавить ресурс" Click="AddResource_Click" Icon="Add" Label="Добавить" />
                    <AppBarButton AutomationProperties.Name="Управлять тэгами" Click="ManageTags_Click" Icon="Tag" Label="Тэги" />
                    <AppBarButton AutomationProperties.Name="Сортировка" Icon="Sort" Label="Сортировка">
                        <AppBarButton.Flyout>
                            <MenuFlyout>
                                <ToggleMenuFlyoutItem x:Name="SortByTitleItem" Click="SortByTitle_Click" IsChecked="True" Text="По названию" />
                                <ToggleMenuFlyoutItem x:Name="SortByModifiedItem" Click="SortByModified_Click" Text="По дате изменения" />
                            </MenuFlyout>
                        </AppBarButton.Flyout>
                    </AppBarButton>
                    <AppBarSeparator />
                    <AppBarToggleButton x:Name="GridViewToggle" AutomationProperties.Name="Сетка" Click="GridViewToggle_Click" Icon="View" IsChecked="True" Label="Сетка" />
                    <AppBarToggleButton x:Name="ListViewToggle" AutomationProperties.Name="Список" Click="ListViewToggle_Click" Label="Список">
                        <AppBarToggleButton.Icon><FontIcon Glyph="&#xE8EF;" /></AppBarToggleButton.Icon>
                    </AppBarToggleButton>
                </CommandBar>

                <VisualStateManager.VisualStateGroups>
                    <VisualStateGroup>
                        <VisualState x:Name="NarrowHeader" />
                        <VisualState x:Name="MediumHeader">
                            <VisualState.StateTriggers><AdaptiveTrigger MinWindowWidth="720" /></VisualState.StateTriggers>
                            <VisualState.Setters>
                                <Setter Target="SearchBox.(Grid.Row)" Value="0" />
                                <Setter Target="SearchBox.(Grid.Column)" Value="1" />
                                <Setter Target="SearchBox.(Grid.ColumnSpan)" Value="2" />
                                <Setter Target="SearchBox.Width" Value="280" />
                                <Setter Target="WorkspaceCommandBar.(Grid.Row)" Value="1" />
                            </VisualState.Setters>
                        </VisualState>
                        <VisualState x:Name="WideHeader">
                            <VisualState.StateTriggers><AdaptiveTrigger MinWindowWidth="1180" /></VisualState.StateTriggers>
                            <VisualState.Setters>
                                <Setter Target="SearchBox.(Grid.Row)" Value="0" />
                                <Setter Target="SearchBox.(Grid.Column)" Value="1" />
                                <Setter Target="SearchBox.(Grid.ColumnSpan)" Value="1" />
                                <Setter Target="SearchBox.Width" Value="280" />
                                <Setter Target="WorkspaceCommandBar.(Grid.Row)" Value="0" />
                                <Setter Target="WorkspaceCommandBar.(Grid.Column)" Value="2" />
                                <Setter Target="WorkspaceCommandBar.(Grid.ColumnSpan)" Value="1" />
                                <Setter Target="WorkspaceCommandBar.HorizontalAlignment" Value="Right" />
                            </VisualState.Setters>
                        </VisualState>
                    </VisualStateGroup>
                </VisualStateManager.VisualStateGroups>
            </Grid>

            <GridView
                x:Name="ResourcesGrid"
                Grid.Row="1"
                AutomationProperties.Name="Ресурсы, сетка"
                CanDragItems="True"
                DragItemsStarting="Resources_DragItemsStarting"
                CanReorderItems="False"
                DoubleTapped="Resources_DoubleTapped"
                IsItemClickEnabled="True"
                ItemClick="Resources_ItemClick"
                ItemsSource="{x:Bind FilteredResources, Mode=OneWay}"
                KeyDown="Resources_KeyDown"
                SelectionChanged="Resources_SelectionChanged"
                SelectionMode="Single">
                <GridView.ItemsPanel><ItemsPanelTemplate><ItemsWrapGrid ItemHeight="194" ItemWidth="224" Orientation="Horizontal" /></ItemsPanelTemplate></GridView.ItemsPanel>
                <GridView.ItemContainerStyle>
                    <Style TargetType="GridViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="VerticalContentAlignment" Value="Stretch" />
                        <Setter Property="Margin" Value="0,0,12,12" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="UseSystemFocusVisuals" Value="True" />
                    </Style>
                </GridView.ItemContainerStyle>
                <GridView.ItemTemplate>
                    <DataTemplate x:DataType="local:WorkspaceResource">
                        <Border AutomationProperties.HelpText="{x:Bind VisualSourceLabel, Mode=OneWay}" AutomationProperties.Name="{x:Bind AccessibleName, Mode=OneWay}" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="10">
                            <ToolTipService.ToolTip>
                                <ToolTip><TextBlock MaxWidth="420" Text="{x:Bind HoverDescription, Mode=OneWay}" TextWrapping="Wrap" /></ToolTip>
                            </ToolTipService.ToolTip>
                            <Border.ContextFlyout>
                                <MenuFlyout>
                                    <MenuFlyoutItem Click="OpenResourceMenu_Click" Icon="OpenFile" Tag="{Binding}" Text="Открыть" />
                                    <MenuFlyoutItem Click="EditResourceMenu_Click" Icon="Edit" Tag="{Binding}" Text="Редактировать" />
                                    <MenuFlyoutItem Click="RestoreResourceMenu_Click" Tag="{Binding}" Text="Восстановить" />
                                    <MenuFlyoutItem AutomationProperties.Name="Удалить ресурс" Click="DeleteResourceMenu_Click" Icon="Delete" Tag="{Binding}" Text="Удалить" />
                                </MenuFlyout>
                            </Border.ContextFlyout>
                            <Grid RowSpacing="0">
                                <Grid.RowDefinitions><RowDefinition Height="{x:Bind CardPreviewHeight, Mode=OneWay}" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                                <Border Background="{x:Bind AccentBrush}" CornerRadius="10,10,0,0">
                                    <Grid>
                                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" Visibility="{x:Bind IconSurfaceVisibility, Mode=OneWay}" />
                                        <Image Margin="{x:Bind VisualImageMargin, Mode=OneWay}" AutomationProperties.AccessibilityView="Raw" Source="{x:Bind VisualImage, Mode=OneWay}" Stretch="{x:Bind VisualStretch, Mode=OneWay}" Visibility="{x:Bind VisualImageVisibility, Mode=OneWay}" />
                                        <TextBlock Margin="14" VerticalAlignment="Center" FontSize="13" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" MaxLines="3" Text="{x:Bind VisualPreviewText, Mode=OneWay}" TextTrimming="CharacterEllipsis" TextWrapping="Wrap" Visibility="{x:Bind GeneratedPreviewVisibility, Mode=OneWay}" />
                                        <FontIcon FontSize="34" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" Glyph="{x:Bind Glyph}" Visibility="{x:Bind FallbackVisibility, Mode=OneWay}" />
                                        <Border HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="8" Padding="8,5" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="6" Visibility="{x:Bind VisualLoadingVisibility, Mode=OneWay}">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <ProgressRing Width="16" Height="16" IsActive="{x:Bind IsVisualLoading, Mode=OneWay}" />
                                                <TextBlock VerticalAlignment="Center" FontSize="12" Text="Получаем превью…" />
                                            </StackPanel>
                                        </Border>
                                        <Button HorizontalAlignment="Right" VerticalAlignment="Top" Margin="4" Click="DeleteResourceButton_Click" Tag="{Binding}" ToolTipService.ToolTip="Удалить ресурс" Visibility="{x:Bind CardDeleteVisibility, Mode=OneWay}">
                                            <SymbolIcon Symbol="Delete" />
                                        </Button>
                                    </Grid>
                                </Border>
                                <StackPanel Grid.Row="1" Padding="8,7,8,6" Spacing="3">
                                    <TextBlock FontSize="14" FontWeight="SemiBold" MaxLines="{x:Bind CardTitleLines, Mode=OneWay}" Text="{x:Bind Title}" TextTrimming="CharacterEllipsis" TextWrapping="Wrap" Visibility="{x:Bind CardTitleVisibility, Mode=OneWay}" />
                                    <TextBlock FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" MaxLines="{x:Bind CardDescriptionLines, Mode=OneWay}" Text="{x:Bind Description}" TextTrimming="CharacterEllipsis" TextWrapping="Wrap" Visibility="{x:Bind CardDescriptionVisibility, Mode=OneWay}" />
                                    <TextBlock FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" MaxLines="1" Text="{x:Bind TagsDisplay}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}" MaxLines="1" Text="{x:Bind SourceOrType}" TextTrimming="CharacterEllipsis" Visibility="{x:Bind CardSourceVisibility, Mode=OneWay}" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </GridView.ItemTemplate>
            </GridView>

            <ListView
                x:Name="ResourcesList"
                CanDragItems="True"
                DragItemsStarting="Resources_DragItemsStarting"
                Grid.Row="1"
                AutomationProperties.Name="Ресурсы, список"
                DoubleTapped="Resources_DoubleTapped"
                IsItemClickEnabled="True"
                ItemClick="Resources_ItemClick"
                ItemsSource="{x:Bind FilteredResources, Mode=OneWay}"
                KeyDown="Resources_KeyDown"
                SelectionChanged="Resources_SelectionChanged"
                SelectionMode="Single"
                Visibility="Collapsed">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="MinHeight" Value="60" />
                        <Setter Property="Padding" Value="8,4" />
                        <Setter Property="UseSystemFocusVisuals" Value="True" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="local:WorkspaceResource">
                        <Grid MinHeight="56" AutomationProperties.HelpText="{x:Bind VisualSourceLabel, Mode=OneWay}" AutomationProperties.Name="{x:Bind AccessibleName, Mode=OneWay}" ColumnSpacing="12">
                            <Grid.ContextFlyout>
                                <MenuFlyout>
                                    <MenuFlyoutItem Click="OpenResourceMenu_Click" Icon="OpenFile" Tag="{Binding}" Text="Открыть" />
                                    <MenuFlyoutItem Click="EditResourceMenu_Click" Icon="Edit" Tag="{Binding}" Text="Редактировать" />
                                    <MenuFlyoutItem Click="RestoreResourceMenu_Click" Tag="{Binding}" Text="Восстановить" />
                                    <MenuFlyoutItem AutomationProperties.Name="Удалить ресурс" Click="DeleteResourceMenu_Click" Icon="Delete" Tag="{Binding}" Text="Удалить" />
                                </MenuFlyout>
                            </Grid.ContextFlyout>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="44" /><ColumnDefinition Width="*" /><ColumnDefinition Width="150" /><ColumnDefinition Width="130" /><ColumnDefinition Width="120" /></Grid.ColumnDefinitions>
                            <Border Width="40" Height="40" Background="{x:Bind AccentBrush}" CornerRadius="7">
                                <Grid>
                                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="7" Visibility="{x:Bind IconSurfaceVisibility, Mode=OneWay}" />
                                    <Image Margin="{x:Bind ListVisualImageMargin, Mode=OneWay}" AutomationProperties.AccessibilityView="Raw" Source="{x:Bind VisualImage, Mode=OneWay}" Stretch="{x:Bind VisualStretch, Mode=OneWay}" Visibility="{x:Bind VisualImageVisibility, Mode=OneWay}" />
                                    <FontIcon FontSize="18" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" Glyph="{x:Bind Glyph}" Visibility="{x:Bind FallbackVisibility, Mode=OneWay}" />
                                </Grid>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                <TextBlock FontWeight="SemiBold" MaxLines="1" Text="{x:Bind Title}" TextTrimming="CharacterEllipsis" />
                                <TextBlock FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Получаем превью…" Visibility="{x:Bind VisualLoadingVisibility, Mode=OneWay}" />
                            </StackPanel>
                            <TextBlock Grid.Column="2" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" MaxLines="1" Text="{x:Bind SourceOrType}" TextTrimming="CharacterEllipsis" Visibility="{x:Bind SourceColumnVisibility, Mode=OneWay}" />
                            <TextBlock Grid.Column="3" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" MaxLines="1" Text="{x:Bind TagsDisplay}" TextTrimming="CharacterEllipsis" Visibility="{x:Bind TagsColumnVisibility, Mode=OneWay}" />
                            <TextBlock Grid.Column="4" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorTertiaryBrush}" MaxLines="1" Text="{x:Bind Modified}" TextTrimming="CharacterEllipsis" Visibility="{x:Bind DateColumnVisibility, Mode=OneWay}" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <Grid Grid.Row="2" Margin="4,8,0,0">
                <TextBlock x:Name="StatusText" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <StackPanel x:Name="DropHint" HorizontalAlignment="Right" Orientation="Horizontal" Spacing="7">
                    <FontIcon FontSize="13" Foreground="{ThemeResource TextFillColorTertiaryBrush}" Glyph="&#xE8B7;" />
                    <TextBlock FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}" Text="Перетащите сюда файлы, папки или web-ссылки" />
                </StackPanel>
            </Grid>

            <Border x:Name="DropOverlay" Grid.RowSpan="3" Margin="6" IsHitTestVisible="False" Visibility="Collapsed" Background="{ThemeResource SubtleFillColorSecondaryBrush}" BorderBrush="{ThemeResource AccentFillColorDefaultBrush}" BorderThickness="2" CornerRadius="14">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10">
                    <FontIcon FontSize="40" Glyph="&#xE896;" />
                    <TextBlock FontSize="18" FontWeight="SemiBold" Text="Отпустите, чтобы добавить ресурс" />
                </StackPanel>
            </Border>
        </Grid>
    </NavigationView>
</Page>
